# Golden snapshot fixtures are compared byte-exact on every platform;
# Windows runners default to CRLF checkout conversion, which once broke
# the timeline golden snapshot (native drift, not logic drift). Pin the
# corpus and evidence text to LF on checkout.
*.txt   text eol=lf
*.jsonl text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.go    text eol=lf
*.mjs   text eol=lf
